<?xml version="1.0" encoding="UTF-8"?>
<!--
  Optional Maven toolchains file for JDK 21.
  Copy to your user Maven directory (not committed):

    Windows: %USERPROFILE%\.m2\toolchains.xml
    Linux/macOS: ~/.m2/toolchains.xml

  Adjust the jdkHome path to your local JDK 21 installation.
-->
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 https://maven.apache.org/xsd/toolchains-1.1.0.xsd">
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>21</version>
    </provides>
    <configuration>
      <jdkHome>C:\Program Files\Java\jdk-21.0.11</jdkHome>
    </configuration>
  </toolchain>
</toolchains>
